<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Assistant - Production Chat</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="notifications.css">
    <script src="notifications.js"></script>
    <style>
        :root {
            --bg-main: #0a0f1e;
            --bg-sidebar: #050a18;
            --border: rgba(255, 255, 255, 0.08);
            --accent: #3b82f6;
            --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            --accent-glow: rgba(59, 130, 246, 0.4);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --surface: rgba(15, 23, 42, 0.8);
            --surface-hover: rgba(30, 41, 59, 0.9);
        }

        body {
            background-color: var(--bg-main);
            background-image:
                radial-gradient(circle at 50% -20%, #1e293b 0%, transparent 70%),
                radial-gradient(circle at 0% 100%, #0f172a 0%, transparent 50%);
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, sans-serif;
            margin: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 280px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 20;
            backdrop-filter: blur(20px);
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border);
        }

        .home-link {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: white;
            font-weight: 600;
            padding: 12px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .home-link:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--accent);
            transform: translateY(-1px);
        }

        .sidebar-content {
            flex: 1;
            padding: 24px;
            overflow-y: auto;
        }

        .sidebar-title {
            text-transform: uppercase;
            font-size: 0.7rem;
            color: var(--text-secondary);
            letter-spacing: 0.1em;
            margin-bottom: 20px;
            display: block;
            font-weight: 700;
        }

        .assistant-profile {
            background: rgba(37, 99, 235, 0.05);
            border: 1px solid rgba(37, 99, 235, 0.15);
            padding: 18px;
            border-radius: 16px;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }

        .assistant-profile::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, transparent, rgba(37, 99, 235, 0.05), transparent);
            transform: translateX(-100%);
            animation: shine 3s infinite;
        }

        @keyframes shine {
            100% {
                transform: translateX(100%);
            }
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .profile-icon {
            font-size: 1.6rem;
            width: 48px;
            height: 48px;
            background: var(--accent-gradient);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 16px var(--accent-glow);
        }

        .profile-info h3 {
            font-size: 1rem;
            margin: 0;
            color: white;
            font-weight: 600;
        }

        .profile-status {
            font-size: 0.75rem;
            color: #22c55e;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: currentColor;
            border-radius: 50%;
            box-shadow: 0 0 10px currentColor;
            animation: breathe 2s infinite;
        }

        @keyframes breathe {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* Main Chat Area */
        .chat-view {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            background: transparent;
        }

        .chat-body {
            flex: 1;
            overflow-y: auto;
            padding: 40px 0 200px 0;
            /* Added bottom padding for fixed footer */
            display: flex;
            flex-direction: column;
            gap: 32px;
            scroll-behavior: smooth;
        }

        .message-container {
            max-width: 850px;
            width: 90%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .msg-group {
            display: flex;
            gap: 20px;
            max-width: 85%;
            animation: slideIn 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .bot-msg-group {
            align-self: flex-start;
        }

        .user-msg-group {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .msg-avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            margin-top: 4px;
        }

        .bot-avatar {
            background: var(--accent-gradient);
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .user-avatar {
            background: #334155;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .msg-content {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
        }

        .msg-bubble {
            padding: 16px 20px;
            border-radius: 18px;
            font-size: 1rem;
            line-height: 1.6;
            color: #f1f5f9;
        }

        .bot-bubble {
            background: var(--surface);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-top-left-radius: 4px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .user-bubble {
            background: var(--accent-gradient);
            color: white;
            border-top-right-radius: 4px;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
        }

        /* Input Area Outer Container */
        .chat-footer {
            padding: 20px 0 40px 0;
            background: linear-gradient(to top, var(--bg-main) 70%, transparent);
            position: fixed;
            bottom: 0;
            left: 280px;
            /* Sidebar width */
            right: 0;
            z-index: 10;
        }

        .input-container {
            max-width: 850px;
            width: 90%;
            margin: 0 auto;
        }

        .input-box {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 12px 18px;
            display: flex;
            align-items: flex-end;
            gap: 16px;
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .input-box:focus-within {
            border-color: var(--accent);
            background: rgba(15, 23, 42, 0.8);
            transform: translateY(-2px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--accent);
        }

        #messageInput {
            flex: 1;
            background: transparent;
            border: none;
            color: white;
            font-size: 1.05rem;
            outline: none;
            padding: 12px 4px;
            resize: none;
            max-height: 200px;
            font-family: inherit;
            line-height: 1.5;
        }

        .send-btn {
            background: var(--accent-gradient);
            border: none;
            width: 42px;
            height: 42px;
            border-radius: 14px;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .send-btn:hover {
            transform: scale(1.05) translateY(-1px);
            filter: brightness(1.1);
        }

        .attach-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            width: 42px;
            height: 42px;
            border-radius: 14px;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

        .attach-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-color: var(--accent);
        }

        /* Suggestion Pills */
        .suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        .suggestion-pill {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            padding: 10px 20px;
            border-radius: 100px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 500;
        }

        .suggestion-pill:hover {
            background: var(--accent-gradient);
            color: white;
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 8px 16px var(--accent-glow);
        }

        /* History List */
        .history-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 14px;
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 0.95rem;
            transition: 0.3s;
            margin-bottom: 4px;
        }

        .history-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .history-item.active {
            background: rgba(37, 99, 235, 0.1);
            color: white;
            border: 1px solid rgba(37, 99, 235, 0.2);
        }

        .new-chat-btn {
            width: 100%;
            background: var(--accent-gradient);
            border: none;
            color: white;
            padding: 14px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: 0.3s;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .new-chat-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
            box-shadow: 0 8px 20px var(--accent-glow);
        }

        /* Custom Scrollbar */
        *::-webkit-scrollbar {
            width: 6px;
        }

        *::-webkit-scrollbar-track {
            background: transparent;
        }

        *::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
        }

        /* Markdown & Content Formatting */
        .bot-bubble ul,
        .bot-bubble ol {
            margin: 12px 0;
            padding-left: 24px;
        }

        .bot-bubble li {
            margin-bottom: 8px;
        }

        .bot-bubble code {
            background: rgba(0, 0, 0, 0.3);
            padding: 4px 8px;
            border-radius: 6px;
            font-family: 'Fira Code', 'Courier New', monospace;
            font-size: 0.9em;
            color: #60a5fa;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .bot-bubble strong {
            color: white;
            font-weight: 700;
        }

        /* Premium Typing Indicator */
        .typing-indicator {
            display: flex;
            gap: 5px;
            padding: 10px 0;
            align-items: center;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            opacity: 0.6;
            animation: pulse-dot 1.5s infinite ease-in-out;
        }

        .dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .dot:nth-child(3) {
            animation-delay: 0.4s;
        }

        @keyframes pulse-dot {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.4;
            }

            50% {
                transform: scale(1.3);
                opacity: 1;
                filter: drop-shadow(0 0 5px var(--accent));
            }
        }

        /* Message Actions */
        .msg-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0;
            transition: 0.3s;
        }

        .msg-group:hover .msg-actions {
            opacity: 1;
        }

        .msg-action-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: 0.2s;
        }

        .msg-action-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .msg-action-btn svg {
            opacity: 0.7;
        }

        .msg-action-btn:hover svg {
            opacity: 1;
        }

        /* Attachment Menu Styling */
        .attach-menu {
            position: absolute;
            bottom: 120px;
            left: 20px;
            width: 280px;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(30px);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px) scale(0.95);
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
        }

        .attach-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 15px;
            border-radius: 12px;
            border: none;
            background: transparent;
            color: var(--text-primary);
            font-size: 0.95rem;
            cursor: pointer;
            transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
            text-align: left;
            width: 100%;
        }

        .menu-item:hover {
            background: rgba(255, 255, 255, 0.05);
            padding-left: 20px;
            color: var(--accent);
        }

        .menu-icon {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        .menu-divider {
            height: 1px;
            background: var(--border);
            margin: 6px 10px;
        }

        .model-select-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            border-radius: 100px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            cursor: pointer;
            transition: 0.3s;
            white-space: nowrap;
        }

        .model-select-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-color: var(--accent);
        }

        /* Welcome Center */
        .welcome-center {
            padding: 80px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .welcome-icon {
            font-size: 3.5rem;
            width: 100px;
            height: 100px;
            background: var(--accent-gradient);
            border-radius: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            box-shadow: 0 20px 50px var(--accent-glow);
            animation: pulse-glow 3s infinite;
        }

        @keyframes pulse-glow {

            0%,
            100% {
                box-shadow: 0 20px 40px rgba(59, 130, 246, 0.3);
                transform: translateY(0);
            }

            50% {
                box-shadow: 0 30px 60px rgba(59, 130, 246, 0.5);
                transform: translateY(-5px);
            }
        }

        .welcome-center h1 {
            font-size: 2.2rem;
            margin-bottom: 16px;
            font-weight: 800;
            background: linear-gradient(to bottom, #fff, #94a3b8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @media (max-width: 768px) {
            .sidebar {
                position: absolute;
                left: -280px;
                height: 100%;
            }

            .sidebar.active {
                transform: translateX(280px);
            }

            .chat-header-mobile {
                display: flex;
                background: var(--bg-sidebar);
                padding: 16px 24px;
                border-bottom: 1px solid var(--border);
                align-items: center;
                gap: 20px;
            }

            .chat-footer {
                left: 0;
                /* Full width on mobile */
            }
        }
    </style>

</head>

<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="index.html" class="home-link">
                <span>🏠</span> Dashboard
            </a>
        </div>
        <div class="sidebar-content" style="padding-top: 10px;">
            <button class="new-chat-btn" onclick="startNewChat()">
                <span>+</span> New Chat
            </button>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="sidebar-title" style="margin:0;">Recent Chats</span>
                <button onclick="clearHistory()"
                    style="background:none; border:none; color:var(--text-secondary); font-size:0.7rem; cursor:pointer; text-decoration:underline;">Clear</button>
            </div>
            <div id="recentChatsList" class="history-list">
                <!-- Dynamic entries will be injected here -->
            </div>
        </div>
    </aside>

    <main class="chat-view">
        <header class="chat-header-mobile">
            <!-- Mobile Header Content Removed as requested -->
        </header>

        <section class="chat-body" id="chatBody">
            <div class="message-container" id="messageContainer">
                <div class="welcome-center">
                    <div class="welcome-icon" id="welcomeAvatar">🤖</div>
                    <h1 id="welcomeAssistantTitle">Assistant</h1>
                    <p>I can help you with advice, planning, or answering any questions you have. How can I assist you
                        today?</p>
                </div>
            </div>
        </section>

        <footer class="chat-footer">
            <div class="input-container">
                <div id="attachmentPreview" class="attachment-preview" style="display: none;"></div>
                <div class="suggestions" id="suggestions">
                    <!-- Suggestions will be injected by JS -->
                </div>

                <!-- Advanced Attachment Menu -->
                <div id="attachMenu" class="attach-menu">
                    <button type="button" class="menu-item" onclick="handleMenuAction('upload')">
                        <span class="menu-icon">📤</span>
                        <span>Upload a file</span>
                    </button>
                    <button type="button" class="menu-item" onclick="handleMenuAction('text')">
                        <span class="menu-icon">📝</span>
                        <span>Add text content</span>
                    </button>
                    <button type="button" class="menu-item" onclick="handleMenuAction('sketch')">
                        <span class="menu-icon">🎨</span>
                        <span>Draw a sketch</span>
                    </button>
                    <div class="menu-divider"></div>
                    <button type="button" class="menu-item" onclick="handleMenuAction('drive')">
                        <span class="menu-icon">📁</span>
                        <span>Connect Google Drive</span>
                    </button>
                    <button type="button" class="menu-item" onclick="handleMenuAction('onedrive')">
                        <span class="menu-icon">☁️</span>
                        <span>Connect Microsoft OneDrive</span>
                    </button>
                    <div class="menu-divider"></div>
                    <button type="button" class="menu-item" onclick="handleMenuAction('recent')">
                        <span class="menu-icon">🕒</span>
                        <div style="flex:1; display: flex; justify-content: space-between; align-items: center;">
                            <span>Recent</span>
                            <span style="font-size: 0.8rem; opacity: 0.5;">></span>
                        </div>
                    </button>
                </div>

                <form id="chatForm">
                    <div class="input-box">
                        <input type="file" id="fileInput" multiple style="display: none"
                            accept="image/*,.pdf,.doc,.docx,.txt">
                        <button type="button" class="attach-btn" onclick="toggleAttachMenu(event)" title="Attachments">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path
                                    d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48">
                                </path>
                            </svg>
                        </button>
                        <textarea id="messageInput" placeholder="How can AI help you today?" rows="1"
                            autocomplete="off"></textarea>

                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div class="model-select-btn">
                                🚀 <span>Auto</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M6 9l6 6 6-6"></path>
                                </svg>
                            </div>
                            <button type="submit" class="send-btn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                </svg>
                            </button>
                        </div>
                    </div>
                </form>
                <div style="text-align: center; color: var(--text-secondary); font-size: 0.7rem; margin-top: 10px;">
                    AI Assistant Hub v2.0 • Intelligent Agency for Every Task
                </div>
            </div>
        </footer>
    </main>

    <script src="chat.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.remove('active');
        }
    </script>

    <!-- Premium Auth Modal -->
    <div id="authModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-close" onclick="closeAuthModal()">&times;</div>
            <div class="modal-icon">🔒</div>
            <h2>Login Required</h2>
            <p>You need to be logged in to access our specialized AI assistants and maintain your chat history. It's
                free and
                takes just a minute!</p>
            <div class="modal-actions">
                <button class="btn-modal-primary" onclick="window.location.href='forms/login.html'">Login Now</button>
                <button class="btn-modal-secondary" onclick="window.location.href='forms/register.html'">Create
                    Account</button>
            </div>
        </div>
    </div>
</body>

</html>
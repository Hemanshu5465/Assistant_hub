# Copy to backend/.env for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (do NOT commit real values).

# ---- Database ----
# Production (Neon / Supabase / any hosted Postgres): use DATABASE_URL.
# SSL is auto-enabled for DATABASE_URL unless PG_SSL=false.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Local Postgres instead (used only when DATABASE_URL is unset):
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=ai_assistant_hub
PG_USER=postgres
PG_PASSWORD=your_local_password
PG_SSL=false

# ---- App ----
PORT=5000
JWT_SECRET=change_me

# ---- Auth / integrations ----
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GROQ_API_KEY=your_groq_api_key

# ---- Email (forgot-password + contact form) ----
EMAIL_USER=your_gmail_address
EMAIL_PASS=your_gmail_app_password
